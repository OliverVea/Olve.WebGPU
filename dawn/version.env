# The Dawn release this binding wraps; scripts, CI and the package metadata read it from here.
# The web build uses this release's emdawnwebgpu remote port (src/Olve.WebGPU.Browser/port/), which CI checks against DAWN_TAG.
DAWN_TAG=v20261111.144539
DAWN_COMMIT=e327e2a60b08179ee8a04056f58dad8ca4b69b5f
# Microsoft.Direct3D.DXC, the DirectXShaderCompiler package Olve.WebGPU.Native depends on (exactly) for D3D12 on Windows
DXC_NUGET_VERSION=1.9.2609.5
# The manylinux_2_28 image (quay.io/pypa/manylinux_2_28_<arch>) Linux natives are built and linked in, like Dawn's own Linux
# build: the library then needs glibc 2.28 or newer
MANYLINUX_TAG=2026.11.07-1
