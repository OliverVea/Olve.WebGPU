<Project Sdk="Microsoft.NET.Sdk">
    <!-- The triangle in a Silk.NET window, through Dawn native from artifacts/native/<rid>/ (scripts/build-natives.sh, build/ProjectNatives.targets). -->
    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="Silk.NET.Windowing" />
        <ProjectReference Include="..\Triangle\Triangle.csproj" />
    </ItemGroup>
    <Import Project="$(RepoRoot)build/ProjectNatives.targets" />
</Project>
